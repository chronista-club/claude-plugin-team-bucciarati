// team.kdl — Team Bucciarati の SSOT（構造化ファクト）
//
// ここが正: ロスター（モデル配分・カラー）、パイプライン構成、コミットライン境界。
// 散文（各エージェントの定義本文・報告フォーマット）は agents/*.md が正。
//
// 整合検証: scripts/check-teamdef.sh
//   team.kdl と agents/*.md frontmatter / SKILL.md / README.md / CLAUDE.md /
//   reference/pipelines.md / plugin.json / CHANGELOG.md のドリフトを検出する。

team "bucciarati" {
    scope "強く美しいコードに貢献するレイヤーまで（終点: コミット可能な working tree）"

    // どのスタンドも越えない境界。reference/hooks.md のガードと対応。
    commit-line {
        forbidden "commit"
        forbidden "push"
        forbidden "merge"
        forbidden "gh pr"
    }

    roster {
        stand "aerosmith" display="Aerosmith" user="Narancia Ghirga" role="Orchestrator" model="sonnet" color="green"
        stand "purple-haze" display="Purple Haze" user="Pannacotta Fugo" role="Research" model="opus" color="red"
        stand "gold-experience" display="Gold Experience" user="Giorno Giovanna" role="Implementation" model="opus" color="yellow"
        stand "spice-girl" display="Spice Girl" user="Trish Una" role="Test Generation" model="sonnet" color="pink"
        stand "moody-blues" display="Moody Blues" user="Leone Abbacchio" role="Quality Gate" model="sonnet" color="purple"
        stand "sticky-fingers" display="Sticky Fingers" user="Bruno Bucciarati" role="Refactoring" model="opus" color="blue"
        stand "sex-pistols" display="Sex Pistols" user="Guido Mista" role="Parallel Code Work" model="sonnet" color="orange"
    }

    // モデル配分の原則: 思考の深さが質を決める仕事 = opus / 規律が質を決める頻出の仕事 = sonnet
    // さらに深い思考が必要な場面は呼び出し時に fable を指定（frontmatter には固定しない）

    pipelines {
        pipeline "Finish" default=#true use-case="手元の変更をコミット可能な品質に仕上げる" {
            step "spice-girl" optional=#true
            step "moody-blues"
        }
        pipeline "Forge" use-case="要件から実装一式" {
            step "purple-haze" optional=#true
            step "gold-experience"
            step "spice-girl"
            step "moody-blues"
        }
        pipeline "Polish" use-case="挙動を変えずに構造改善" {
            step "sticky-fingers"
            step "moody-blues"
        }
        pipeline "Barrage" use-case="独立作業の並列一斉実行" {
            step "sex-pistols"
            step "moody-blues"
        }
        pipeline "Research" use-case="調査のみ" {
            step "purple-haze"
        }
    }
}
