// team.kdl — Team Bucciarati の SSOT（構造化ファクト）
//
// ここが正: ロスター（モデル配分・カラー）、コミットライン境界。
// 散文（各エージェントの定義本文・報告フォーマット）は agents/*.md が正。
//
// 整合検証: scripts/check-teamdef.sh
//   team.kdl と agents/*.md frontmatter / SKILL.md / README.md / CLAUDE.md /
//   plugin.json / CHANGELOG.md のドリフトを検出する。

team "bucciarati" {
    scope "開発の前後（調査・テスト・レビュー・検証）で強く美しいコードに貢献する（終点: コミット可能な working tree）"

    // どのスタンドも越えない境界。reference/hooks.md のガードと対応。
    commit-line {
        forbidden "commit"
        forbidden "push"
        forbidden "merge"
        forbidden "gh pr"
    }

    roster {
        stand "purple-haze" display="Purple Haze" user="Pannacotta Fugo" role="Research" model="opus" color="red"
        stand "spice-girl" display="Spice Girl" user="Trish Una" role="Test Generation" model="sonnet" color="pink"
        stand "moody-blues" display="Moody Blues" user="Leone Abbacchio" role="Quality Gate" model="opus" color="purple"
        stand "sticky-fingers" display="Sticky Fingers" user="Bruno Bucciarati" role="Adversarial Verification" model="opus" color="blue"
    }

    // モデル配分の原則: 失敗が沈黙する仕事（調査・レビュー・敵対的検証）= opus / 失敗が音を立てる仕事（テスト生成）= sonnet
    // さらに深い思考が必要な場面は呼び出し時に fable を指定（frontmatter には固定しない）
}
